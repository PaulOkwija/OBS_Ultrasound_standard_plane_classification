# Afro-FetalNet inference server configuration.
# Copy to .env and adjust. Every value can also be set as an environment variable.

# Server
HOST=0.0.0.0
PORT=8000

# Model registry directory (relative or absolute path)
MODEL_REGISTRY_DIR=model_registry

# Model to load on startup (leave blank to skip). The latest version is used.
DEFAULT_MODEL=efficientnet_b0

# Inference defaults
TOP_K=5
CONFIDENCE_THRESHOLD=0.0

# Preprocessing (ImageNet statistics)
IMAGE_SIZE=224
NORMALIZE_MEAN=[0.485, 0.456, 0.406]
NORMALIZE_STD=[0.229, 0.224, 0.225]

# Batch inference
MAX_BATCH_SIZE=64
BATCH_WORKERS=4
